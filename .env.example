# PostgreSQL connection string used by the pg pool (lib/db/pool.ts).
# Example: postgres://magas:secret@localhost:5432/magas
DATABASE_URL=

# NextAuth — random string used to sign the session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# App base URL (required in production; inferred in dev but kept for parity).
NEXTAUTH_URL=http://localhost:3000

# Password hashing algorithm — 'argon2' (default/preferred) or 'bcrypt'.
# Hashes auto-detect their scheme at verify time, so switching later
# does not invalidate existing hashes.
HASH_ALGORITHM=argon2

# Google Maps — live delivery tracking. Browser-visible on purpose (Maps
# JS SDK loads client-side); restrict it by HTTP referrer in Google Cloud
# Console, not by keeping it secret. Enable Maps JavaScript API + Places
# API only. Without this set, the map card degrades to an "unavailable"
# notice instead of breaking the page.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Google Maps key, IP-restricted. Not consumed by any code
# yet (Places Autocomplete runs client-side with the key above) — kept
# here so the convention exists if a server-side Places/Geocoding call
# is ever added. Never reuse the browser key above for server calls.
GOOGLE_MAPS_SERVER_KEY=

# NotchPay — primary payment gateway (MTN MoMo + Orange Money
# aggregator). Both keys come from the same place: Business suite →
# Settings → API Keys. Sandbox/live is determined by which key you use,
# not a different host — test keys are prefixed pk_test_/sk_test_, live
# keys have no prefix. Use test keys in development; live keys only in
# production, never committed. Sent together as Authorization (public
# key) + X-Grant (secret key) on every request — see
# lib/payments/notchpay.ts for the full reference, including two points
# that stayed ambiguous even after reading NotchPay's own docs (flagged
# inline there). A missing key here degrades to "NotchPay unavailable"
# and falls through to Fapshi rather than crashing checkout.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
# The webhook hash key from Business suite → Settings → API Keys — used
# to verify the HMAC-SHA256 signature NotchPay sends in the
# `x-notch-signature` header (app/api/payments/notchpay/route.ts). A
# webhook is never trusted without this check passing.
NOTCHPAY_WEBHOOK_SECRET=
# Override only for local fault-injection testing — NotchPay uses a
# single host (https://api.notchpay.co) for both test and live keys, so
# this normally stays unset.
NOTCHPAY_API_BASE_URL=

# Fapshi — fallback gateway, used only if a NotchPay charge initiation
# fails (network/timeout/5xx/auth error, or a missing key — never a
# clean decline). apiuser/apikey pair from a "service" in the Fapshi
# dashboard (Developers → New Service → open the service to reveal
# Sandbox and API credential sections). Use the Sandbox pair in
# development; the live pair only in production, never committed — you
# only see a live apikey once when it's generated, so store it
# somewhere durable right away. See lib/payments/fapshi.ts for the full
# endpoint/auth reference.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# The shared secret configured for this service's webhook in the Fapshi
# dashboard — sent back as the `x-wh-secret` header on every webhook
# call (app/api/payments/fapshi/route.ts), checked with a constant-time
# comparison. A webhook is never trusted without this check passing.
FAPSHI_WEBHOOK_SECRET=
# Optional override — normally left unset, since lib/payments/fapshi.ts
# already picks https://sandbox.fapshi.com or https://live.fapshi.com
# based on NODE_ENV. Set this only for local fault-injection testing of
# the Fapshi-down fallback path.
FAPSHI_API_BASE_URL=

# Dev-only opt-in: set to 'simulate' to use the fake payment processor
# (lib/payments/simulate.ts) instead of real NotchPay/Fapshi calls — lets
# checkout be exercised before sandbox credentials are provisioned.
# Never set this in production.
PAYMENTS_MODE=
