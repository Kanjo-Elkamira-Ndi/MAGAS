# PostgreSQL connection string used by the pg pool (lib/db/pool.ts).
# Example: postgres://magas:secret@localhost:5432/magas
DATABASE_URL=

# NextAuth — random string used to sign the session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# App base URL (required in production; inferred in dev but kept for parity).
NEXTAUTH_URL=http://localhost:3000

# Password hashing algorithm — 'argon2' (default/preferred) or 'bcrypt'.
# Hashes auto-detect their scheme at verify time, so switching later
# does not invalidate existing hashes.
HASH_ALGORITHM=argon2

# Google Maps — live delivery tracking. Browser-visible on purpose (Maps
# JS SDK loads client-side); restrict it by HTTP referrer in Google Cloud
# Console, not by keeping it secret. Enable Maps JavaScript API + Places
# API only. Without this set, the map card degrades to an "unavailable"
# notice instead of breaking the page.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only Google Maps key, IP-restricted. Not consumed by any code
# yet (Places Autocomplete runs client-side with the key above) — kept
# here so the convention exists if a server-side Places/Geocoding call
# is ever added. Never reuse the browser key above for server calls.
GOOGLE_MAPS_SERVER_KEY=

# NotchPay — primary payment gateway (MTN MoMo + Orange Money
# aggregator). Keys come from the NotchPay merchant dashboard after
# business verification. Use sandbox/test keys in development; live
# keys only in production, never committed.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=
# Signing secret used to verify NotchPay webhook payloads
# (app/api/payments/notchpay/route.ts) — a webhook is never trusted
# without this check passing.
NOTCHPAY_WEBHOOK_SECRET=
# Override only for local fault-injection testing of the NotchPay-down
# fallback path, or if their API host differs from the default baked
# into lib/payments/notchpay.ts — leave unset to use NotchPay's real host.
NOTCHPAY_API_BASE_URL=

# Fapshi — fallback gateway, used only if a NotchPay charge initiation
# fails. Apiuser/apikey pair from the Fapshi dashboard.
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_WEBHOOK_SECRET=
# Sandbox and live use separate subdomains, not just different keys on
# one host — set this per environment (see lib/payments/fapshi.ts).
FAPSHI_API_BASE_URL=

# Public base URL used to build provider webhook/redirect callback URLs
# (e.g. an ngrok https URL in local dev). Falls back to NEXTAUTH_URL if
# unset — kept separate since the public tunnel URL often differs from
# NEXTAUTH_URL during local development.
PAYMENTS_CALLBACK_BASE_URL=

# Dev-only opt-in: set to 'simulate' to use the fake payment processor
# (lib/payments/simulate.ts) instead of real NotchPay/Fapshi calls — lets
# checkout be exercised before sandbox credentials are provisioned.
# Never set this in production.
PAYMENTS_MODE=
