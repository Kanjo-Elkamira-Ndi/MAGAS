# PostgreSQL connection string used by the pg pool (lib/db/pool.ts).
# Example: postgres://magas:secret@localhost:5432/magas
DATABASE_URL=

# NextAuth — random string used to sign the session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# App base URL (required in production; inferred in dev but kept for parity).
NEXTAUTH_URL=http://localhost:3000

# Password hashing algorithm — 'argon2' (default/preferred) or 'bcrypt'.
# Hashes auto-detect their scheme at verify time, so switching later
# does not invalidate existing hashes.
HASH_ALGORITHM=argon2
